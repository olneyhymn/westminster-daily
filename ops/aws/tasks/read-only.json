{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LookButDoNotTouch",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket", "s3:ListAllMyBuckets",
                 "s3:GetBucketOwnershipControls", "s3:GetBucketPublicAccessBlock"],
      "Resource": "*"
    }
  ]
}
