{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteGmailArchiveBackupOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::www.reformedconfessions.com/private-backups/gmail-2024/*"
    },
    {
      "Sid": "ListThatOneBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::www.reformedconfessions.com"
    }
  ]
}
