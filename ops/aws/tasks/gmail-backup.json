{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteGmailArchiveBackupOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::www.reformedconfessions.com/private-backups/gmail-2024/*",
        "arn:aws:s3:::hopperhosted/backups/*"
      ]
    },
    {
      "Sid": "ListBuckets",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation", "s3:GetBucketPublicAccessBlock"],
      "Resource": [
        "arn:aws:s3:::www.reformedconfessions.com",
        "arn:aws:s3:::hopperhosted"
      ]
    }
  ]
}
