{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ObjectWork",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject", "s3:GetObjectAcl", "s3:PutObject", "s3:PutObjectAcl",
        "s3:ListBucket", "s3:ListAllMyBuckets", "s3:GetBucketLocation",
        "s3:GetBucketAcl", "s3:GetBucketPolicy",
        "s3:GetBucketOwnershipControls", "s3:GetBucketPublicAccessBlock"
      ],
      "Resource": "*"
    },
    {
      "Sid": "InvalidateCaches",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation", "cloudfront:GetDistribution",
        "cloudfront:ListDistributions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NeverTheseWhateverTheSessionPolicyAsksFor",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject", "s3:DeleteObjectVersion", "s3:DeleteBucket",
        "s3:PutBucketAcl", "s3:PutBucketPolicy", "s3:DeleteBucketPolicy",
        "s3:PutBucketPublicAccessBlock", "s3:PutBucketOwnershipControls",
        "iam:*", "organizations:*", "account:*", "aws-portal:*", "ce:*"
      ],
      "Resource": "*"
    }
  ]
}
